# Copia aquest fitxer com a .env (a l'arrel o a server/) i omple els valors.
# El fitxer .env no es puja al repositori.

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET=
FLASK_DEBUG=false
FLASK_USE_SSL=false
CERT=
KEY=

# Client d'escriptori
DESKTOP_API_BASE_URL=http://127.0.0.1:5000
DESKTOP_API_VERIFY_TLS=false

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_DATABASE=hosp_blanes
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer
